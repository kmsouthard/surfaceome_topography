

# Large artefacts
*.html
!/explorer/index.html
transVsProteins.html

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# Figures and tables regenerated by the notebooks land in the working dir
/code/*/notebooks/**/*.pdf
/code/*/notebooks/**/*.svg
/code/*/notebooks/**/*.png
/code/*/notebooks/**/*.html


# PyMOL drops chemical-component dictionaries (CL.cif, ZN.cif, ...) into the working
# directory when it loads an mmCIF with a ligand; they are cache, not data
/*.cif

# A run's output: tables, figures and executed notebooks (python code/run_notebooks.py out)
/out/
/out_*/

# Raw downloads for rebuilding inputs (build_inputs.py --downloads, fetch_restricted_inputs.py)
/downloads/

# Inputs that may not be redistributed, rebuilt locally by
# code/database/fetch_restricted_inputs.py (see data/inputs/RESTRICTED.json)
/data/inputs/glycosylation/glycomine/N_result.txt
/data/inputs/glycosylation/glycomine/O_result.txt
/data/inputs/glycosylation/glycomine/C_result.txt
/data/inputs/annotation/surfaceome_classification.csv
/data/inputs/cellphonedb/interaction_curated.csv
/data/inputs/cellphonedb/protein_curated.csv
/data/inputs/cellphonedb/complex_curated.csv
/data/inputs/cellphonedb/hla_curated.csv
